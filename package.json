{
  "name": "fintech-internal-tools",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "pnpm --filter @fintech/internal-tools dev",
    "dev:payments": "pnpm --filter @fintech/payments-mock dev",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @fintech/models generate",
    "db:migrate": "pnpm --filter @fintech/models migrate:dev",
    "db:deploy": "pnpm --filter @fintech/models migrate:deploy",
    "db:seed": "tsx scripts/seed.ts",
    "bench:search": "tsx scripts/bench/transaction-search.ts",
    "postinstall": "pnpm --filter @fintech/models generate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fintech/models": "workspace:*",
    "@fintech/platform": "workspace:*",
    "@next/eslint-plugin-next": "15.5.28",
    "@types/node": "22.20.5",
    "dotenv": "16.4.7",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "3.2.7"
  }
}
