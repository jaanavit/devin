# Postgres (local Homebrew or Docker; see README)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fintech_tools?schema=public"
# Used by `pnpm test` (DB integration tests). Must be a separate, disposable database.
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/fintech_tools_test?schema=public"

# Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
# Enables the mocked OIDC identity provider + demo user switcher. Never enable in real prod.
MOCK_IDP_ENABLED="true"

# payments-mock service (PAYMENTS_MOCK_PORT must match the port in PAYMENTS_MOCK_URL)
PAYMENTS_MOCK_PORT="4100"
PAYMENTS_MOCK_URL="http://localhost:4100"
PAYMENTS_MOCK_TOKEN="dev-payments-token"

# Optional integrations (stubbed when unset)
SLACK_WEBHOOK_URL=""
LLM_API_KEY=""

# Sentry error reporting (server + browser). Disabled when empty.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Client secret of the Sentry internal integration whose webhook calls /api/webhooks/sentry.
SENTRY_WEBHOOK_SECRET=""

# Devin API v3 (service user with UseDevinSessions). The relay is stubbed when either is empty.
DEVIN_API_KEY=""
DEVIN_ORG_ID=""
DEVIN_TARGET_REPO="jaanavit/devin"
