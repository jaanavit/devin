generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Analyst
  Reviewer
  Admin
}

model User {
  id        String   @id
  email     String   @unique
  name      String
  roles     Role[]
  idpGroups String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
